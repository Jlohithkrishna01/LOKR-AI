VITE_API_URL=/api

# Google Identity Services / OAuth 2.0 Client ID (from Google Cloud Console)
# Format: xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Sign in with Apple Services ID (from Apple Developer Portal -> Identifiers -> Services IDs)
# Format: com.yourcompany.lokrai.client
VITE_APPLE_CLIENT_ID=your_apple_service_id

# Optional: Custom Apple Redirect URI (defaults to window.location.origin)
# Must match one of the Return URLs configured in Apple Developer Portal
# VITE_APPLE_REDIRECT_URI=https://lokr.ai/login
