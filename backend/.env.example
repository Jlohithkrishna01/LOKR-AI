# MySQL database configuration (set your MySQL username, password, host, port, db)
DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/successfully?charset=utf8mb4

# Alternatively, zero-config local SQLite:
# DATABASE_URL=sqlite:///./lumiq.db

# Groq AI API Key (Get free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_DEFAULT_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# Security: Change this to a secure random string in production
JWT_SECRET=your_jwt_secret_key_change_in_production

# Google OAuth 2.0 Credentials (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Sign in with Apple Credentials (Apple Developer -> Certificates, Identifiers & Profiles)
# APPLE_CLIENT_ID is your Services ID (e.g. com.yourcompany.lokrai.client)
APPLE_CLIENT_ID=your_apple_service_id_here
APPLE_TEAM_ID=your_apple_team_id_here
APPLE_KEY_ID=your_apple_key_id_here
